 struct iris_inst;
 struct iris_core;
+
+/* Correlation metadata does not change the firmware packet layout. */
+struct iris_hfi_pending {
+	spinlock_t lock;
+	u32 packet_id;
+	u32 type;
+	u32 port;
+	bool active;
+	bool responded;
+};
+
+static inline void iris_hfi_pending_init(struct iris_hfi_pending *pending)
+{
+	spin_lock_init(&pending->lock);
+	pending->active = false;
+	pending->responded = false;
+}
+
+static inline int iris_hfi_pending_begin(struct iris_hfi_pending *pending,
+					u32 packet_id, u32 type, u32 port)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&pending->lock, flags);
+	if (pending->active) {
+		ret = -EBUSY;
+	} else {
+		pending->packet_id = packet_id;
+		pending->type = type;
+		pending->port = port;
+		pending->active = true;
+		pending->responded = false;
+	}
+	spin_unlock_irqrestore(&pending->lock, flags);
+	return ret;
+}
+
+static inline bool iris_hfi_pending_match(struct iris_hfi_pending *pending,
+					 u32 packet_id, u32 type, u32 port)
+{
+	unsigned long flags;
+	bool matched;
+
+	spin_lock_irqsave(&pending->lock, flags);
+	matched = pending->active && !pending->responded && pending->packet_id == packet_id &&
+		pending->type == type && pending->port == port;
+	if (matched)
+		pending->responded = true;
+	spin_unlock_irqrestore(&pending->lock, flags);
+	return matched;
+}
+
+static inline bool iris_hfi_pending_active(struct iris_hfi_pending *pending)
+{
+	unsigned long flags;
+	bool active;
+
+	spin_lock_irqsave(&pending->lock, flags);
+	active = pending->active;
+	spin_unlock_irqrestore(&pending->lock, flags);
+	return active;
+}
+
+static inline void iris_hfi_pending_cancel(struct iris_hfi_pending *pending)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&pending->lock, flags);
+	pending->active = false;
+	pending->responded = false;
+	spin_unlock_irqrestore(&pending->lock, flags);
+}
 
