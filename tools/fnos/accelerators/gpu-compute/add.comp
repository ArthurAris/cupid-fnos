#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer InputA { uint a[]; };
layout(set = 0, binding = 1, std430) readonly buffer InputB { uint b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Output { uint result[]; };
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < 255)
        result[i] = a[i] + b[i];
}
